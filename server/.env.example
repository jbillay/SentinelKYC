# Server configuration — copy to server/.env and fill in.
# server/.env is git-ignored. NEVER commit real keys.

# ---------------------------------------------------------------------------
# Companies House — required
# Sign up: https://developer.company-information.service.gov.uk/
# ---------------------------------------------------------------------------
CH_API_KEY=

# ---------------------------------------------------------------------------
# Postgres — required (see server/db/SETUP.md)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://kyc_poc:CHANGE_ME@localhost:5432/kyc_poc

# ---------------------------------------------------------------------------
# Express
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# LLM provider selection — THE switch. Set each task to 'ollama' or 'nvidia'
# independently, restart the server (and worker, in queue mode) to apply.
#   ollama: local models (OLLAMA_* block)
#   nvidia: hosted NIMs   (NVIDIA_* block — needs NVIDIA_API_KEY)
# Leave one unset to fall back to LLM_PROVIDER, then to 'ollama'.
# ---------------------------------------------------------------------------
LLM_OCR_PROVIDER=ollama
LLM_REASONING_PROVIDER=ollama

# Ollama (used by any task set to 'ollama')
OLLAMA_HOST=http://localhost:11434
OLLAMA_OCR_MODEL=glm-ocr
OLLAMA_REASONING_MODEL=llama3.1:8b

# Boot behavior when no LLM provider is reachable:
#   strict (default) — exit with an actionable error (right for dev machines)
#   warn             — log and start anyway (CI / HTTP-surface-only testing)
# LLM_BOOT_CHECK=strict

# NVIDIA NIM (used by any task set to 'nvidia')
# Token: https://build.nvidia.com — the key must have the "Public API Endpoints"
# permission or every inference POST returns 403 Authorization failed.
NVIDIA_API_KEY=
NVIDIA_OCR_MODEL=                   # default: nvidia/nemotron-ocr-v2
NVIDIA_REASONING_MODEL=             # default: meta/llama-3.1-8b-instruct

# CV invoke URL for the OCR NIM, e.g. https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
# (nemoretriever-ocr-v1 is EOL as of 2026-05-18)
NVIDIA_OCR_ENDPOINT=
NVIDIA_OCR_MERGE_LEVEL=             # 'word' | 'sentence' | 'paragraph' (coarsest = least reassembly)
NVIDIA_OCR_CONFIDENCE_MIN=          # drop detections below this confidence (0 = permissive)
NVIDIA_STRUCTURED_METHOD=           # 'functionCalling' | 'jsonMode'

# ---------------------------------------------------------------------------
# Adverse media (GDELT 2.0 DOC API) — optional overrides.
# Defaults are baked in; no API key required.
# ---------------------------------------------------------------------------
# GDELT_DOC_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc
# GDELT_TIMESPAN=12m

# ---------------------------------------------------------------------------
# Agent config encryption (v0.1) — encrypts secret config fields (vendor API
# keys) at rest in Postgres. Required once a secret field is saved via the UI.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
CONFIG_ENCRYPTION_KEY=

# --- Auth / sessions (R1) ---
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
SESSION_SECRET=
# COOKIE_SECURE=true        # set true behind HTTPS in production
# SESSION_TTL_MS=86400000   # session lifetime in ms (default 1 day)
# BCRYPT_COST=12
# AUTH_DEV_BYPASS=false     # local-only: trust x-user-id when set; keep OFF
# Initial passwords for `npm run users:seed` (set, then run the seed once).
SEED_ANALYST_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Durable run execution (R2)
#   inline (default): runs execute in the web process, SSE from memory — no
#           worker needed, behaves exactly as before.
#   queue:  runs execute in a separate worker (`npm run worker`) via pg-boss;
#           SSE crosses the process boundary through the run_events table +
#           LISTEN/NOTIFY. Durable: a web restart no longer loses an in-flight
#           run. No speedup — Ollama stays serial.
# ---------------------------------------------------------------------------
RUN_EXECUTION=inline
# PGBOSS_SCHEMA=pgboss        # Postgres schema pg-boss manages (auto-created)
# WORKER_CONCURRENCY=1        # parallel jobs per worker (keep 1 for Ollama)
# WORKER_RECONCILE=on         # re-drive crashed in-flight runs on worker boot
